---
import Icon from "./Icon.astro";
import type { Project } from "../site";

interface Props { project: Project }
const { project: p } = Astro.props;
const r = 16;
const c = 2 * Math.PI * r;
const pct = Math.max(0, Math.min(100, p.progress));
---
<details class="card project">
  <summary>
    <div class="p-text">
      <div class="p-title">{p.title}</div>
      <div class="p-tag">{p.tagline}</div>
    </div>
    <div class="actions">
      <div class="ring" title={`${pct}% done`} aria-label={`${pct} percent done`}>
        <svg viewBox="0 0 40 40">
          <circle class="track" cx="20" cy="20" r={r} />
          <circle class="value" cx="20" cy="20" r={r} stroke-dasharray={c} stroke-dashoffset={c * (1 - pct / 100)} />
        </svg>
        <span>{pct}%</span>
      </div>
      {p.github && <a href={p.github} aria-label={`${p.title} on GitHub`}><Icon name="github" /></a>}
      {p.x && <a href={p.x} aria-label={`${p.title} on X`}><Icon name="x" /></a>}
      <span class="chev" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
    </div>
  </summary>
  <div class="desc">
    <p>{p.description}</p>
    {p.image && <img src={p.image} alt="" loading="lazy" />}
  </div>
</details>
