---
import Base from "../layouts/Base.astro";
import { SITE, PROJECTS } from "../site";
import { getPosts } from "../posts";

const posts = getPosts();
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base>
  <h1>Hi, I’m Vineeth.</h1>
  <p class="bio">{SITE.bio}</p>

  <section id="writing">
    <h2 class="section-title">Writing</h2>
    {posts.map((p) => (
      <a class="card" href={p.url}>
        <div class="date">{fmt(p.date)}</div>
        <div class="title">{p.title}</div>
        <div class="summary">{p.summary}</div>
      </a>
    ))}
  </section>

  <section id="projects">
    <h2 class="section-title">Projects</h2>
    {PROJECTS.map((p) => (
      <a class="card project" href={p.href}>
        <img src={p.image} alt="" loading="lazy" />
        <div>
          <div class="title">{p.title}</div>
          <div class="summary">{p.summary}</div>
        </div>
        <span class="arrow">↗</span>
      </a>
    ))}
  </section>
</Base>
