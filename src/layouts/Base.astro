---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  date?: string;
}
const { title, description = SITE.description, image = "/media/demo-poster.jpg", type = "website", date } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fonts =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap";

// Structured data so search engines tie this site (and its posts) to me and my profiles.
const person = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: SITE.name,
  url: SITE.url,
  jobTitle: "Applied AI Engineer",
  description: SITE.description,
  sameAs: [SITE.github, SITE.x, SITE.linkedin],
};
const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogImage,
        url: canonical,
        datePublished: date,
        author: person,
      }
    : {
        "@context": "https://schema.org",
        "@graph": [{ "@type": "WebSite", name: SITE.name, url: SITE.url, author: { "@id": person["@id"] } }, person],
      };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@vineethkalluru" />
    {date && <meta property="article:published_time" content={date} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="name" href="/">{SITE.name}</a>
        <nav><a href="/#writing">Writing</a><a href="/#projects">Projects</a></nav>
      </header>
      <main><slot /></main>
      <footer class="site">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="links">
          <a href={SITE.github} aria-label="GitHub"><Icon name="github" /></a>
          <a href={SITE.x} aria-label="X"><Icon name="x" /></a>
          {SITE.linkedin && <a href={SITE.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>}
          <a href="/rss.xml" aria-label="RSS feed"><Icon name="rss" /></a>
        </span>
      </footer>
    </div>
  </body>
</html>
