---
import Base from "./Base.astro";

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date);
const pretty = date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title={frontmatter.title} description={frontmatter.summary} image={frontmatter.image} type="article" date={date.toISOString()}>
  <article>
    <h1>{frontmatter.title}</h1>
    <div class="meta">{pretty}</div>
    <slot />
  </article>
</Base>
